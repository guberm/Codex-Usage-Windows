<Window x:Class="CodexUsage.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex Usage" Width="190" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#191C21"/><SolidColorBrush x:Key="TextBrush" Color="#F2F5FA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A7B0BD"/><SolidColorBrush x:Key="LineBrush" Color="#3A404B"/>
    <SolidColorBrush x:Key="CardBrush" Color="#242830"/><SolidColorBrush x:Key="AccentBrush" Color="#7EE3BA"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,5,0,5"/></Style>
  </Window.Resources>
  <Border x:Name="Shell" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="17">
    <StackPanel>
      <Border x:Name="Handle" Background="Transparent" Padding="10,7" Cursor="Hand" ToolTip="Click for details · drag to move · right-click for menu"
              MouseLeftButtonDown="HandleDown" MouseMove="HandleMove" MouseLeftButtonUp="HandleUp" Focusable="True"
              KeyDown="HandleKey" AutomationProperties.Name="Toggle usage details">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
          <TextBlock Text="◉" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" FontSize="15"/>
          <TextBlock x:Name="Percent" Grid.Column="1" Text="Sign in" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="Countdown" Grid.Column="2" Text="" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="5,0" FontSize="12"/>
          <TextBlock x:Name="Chevron" Grid.Column="3" Text="⌄" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
        </Grid>
      </Border>
      <ScrollViewer x:Name="Details" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" MaxHeight="650">
        <StackPanel Margin="16,5,16,14">
          <Grid Margin="0,2,0,12">
            <TextBlock Text="CODEX USAGE" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="PlanLabel" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
          </Grid>
          <TextBlock x:Name="AccountLabel" Text="Your limits, always in view." Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
          <StackPanel x:Name="LimitCards"/>
          <TextBlock x:Name="CreditsLabel" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <TextBlock x:Name="StatusLabel" Text="Sign in securely with your ChatGPT account." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
          <StackPanel x:Name="LoginPanel" Visibility="Collapsed" Margin="0,0,0,10">
            <TextBlock Text="Enter this code in your browser:" Foreground="{DynamicResource MutedBrush}"/>
            <TextBox x:Name="DeviceCodeText" IsReadOnly="True" FontSize="22" FontWeight="SemiBold" HorizontalContentAlignment="Center" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="10" Margin="0,8" AutomationProperties.Name="ChatGPT device code"/>
            <WrapPanel><Button Content="Copy code" Click="CopyCode"/><Button Content="Open browser" Click="OpenLoginBrowser"/><Button Content="Cancel" Click="CancelLogin"/></WrapPanel>
            <TextBlock Text="If prompted, enable device code authorization in ChatGPT Settings → Security." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/>
          </StackPanel>
          <WrapPanel>
            <Button x:Name="SignInButton" Content="Sign in with ChatGPT" Click="SignIn"/>
            <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshClick" Visibility="Collapsed"/>
            <Button x:Name="ResetButton" Content="Use reset" Click="ResetClick" Visibility="Collapsed"/>
          </WrapPanel>
          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,8,0,10"/>
          <CheckBox x:Name="PinnedCheck" Content="Always on top" Click="PinChanged"/>
          <CheckBox x:Name="FloatingCheck" Content="Show floating window" Click="FloatingChanged"/>
          <CheckBox x:Name="NotifyCheck" Content="Notify on usage changes (±1%)" Click="NotifyChanged"/>
          <CheckBox x:Name="StartupCheck" Content="Start with Windows" Click="StartupChanged"/>
          <TextBlock Text="Auto-refresh every 15 minutes, on unlock and reconnect." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,12"/>
          <WrapPanel><Button Content="Hide to tray" Click="HideClick"/><Button x:Name="SignOutButton" Content="Sign out" Click="SignOut" Visibility="Collapsed"/><Button Content="Exit" Click="ExitClick"/></WrapPanel>
          <TextBlock Text="Unofficial companion · v0.1.1" Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
        </StackPanel>
      </ScrollViewer>
    </StackPanel>
  </Border>
</Window>
